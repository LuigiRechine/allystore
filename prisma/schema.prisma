generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model Loja {
    id           BigInt   @id @default(autoincrement())
    nome         String   @db.VarChar(150)
    slug         String   @unique @db.VarChar(100)
    logo         String?  @db.VarChar(500)
    descricao    String?  @db.Text
    email        String   @db.VarChar(150)
    telefone     String?  @db.VarChar(20)
    status       String   @db.VarChar(30)
    dataCriacao  DateTime @default(now())

    lojistas     Lojista[]
    clientes     Cliente[]
    categorias   Categoria[]
    produtos     Produto[]
    pedidos      Pedido[]
    carrinhos    Carrinho[]
}

model Usuario {
    id          BigInt   @id @default(autoincrement())
    nome        String   @db.VarChar(255)
    email       String   @db.VarChar(255)
    senha       String   @db.VarChar(255)
    telefone    String   @db.VarChar(255)
    tipo        String   @db.VarChar(255)
    status      String   @db.VarChar(255)
    dataCriacao DateTime @default(now())

    administradores Administrador[]
    lojistas        Lojista[]
    clientes        Cliente[]
}

model Administrador {
    id          BigInt @id @default(autoincrement())
    nivelAcesso String @db.VarChar(30)

    usuarioId BigInt
    usuario   Usuario @relation(fields: [usuarioId], references: [id])
}

model Lojista {
    id           BigInt   @id @default(autoincrement())
    cargo        String   @db.VarChar(30)
    data_vinculo DateTime @default(now())

    usuarioId BigInt
    lojaId    BigInt

    usuario Usuario @relation(fields: [usuarioId], references: [id])
    loja    Loja    @relation(fields: [lojaId], references: [id])
}


model Categoria {
    id        BigInt  @id @default(autoincrement())
    nome      String  @db.VarChar(100)
    descricao String? @db.Text
    status    String  @db.VarChar(30)

    lojaId BigInt

    loja     Loja      @relation(fields: [lojaId], references: [id])
    produtos Produto[]
}

model Produto {
    id        BigInt  @id @default(autoincrement())
    nome      String  @db.VarChar(255)
    descricao String  @db.VarChar(255)
    preco     Decimal @db.Decimal(10, 2)
    status    String  @db.VarChar(255)
    destaque  Boolean @default(true)

    categoriaId BigInt
    lojaId      BigInt

    categoria Categoria @relation(fields: [categoriaId], references: [id])
    loja      Loja      @relation(fields: [lojaId], references: [id])

    produtosVariacao ProdutoVariacao[]
    imagens          Imagem[]
    produtoPedido    ProdutoPedido[]
}

model ProdutoVariacao {
    id       BigInt  @id @default(autoincrement())
    sku      String  @unique @db.VarChar(100)
    cor      String  @db.VarChar(50)
    tamanho  String  @db.VarChar(30)
    preco    Decimal @db.Decimal(10, 2)
    status   String  @db.VarChar(30)

    produtoId BigInt

    produto Produto @relation(fields: [produtoId], references: [id])

    estoques         Estoque[]
    produtosCarrinho ProdutoCarrinho[]
}

model Imagem {
    id     BigInt @id @default(autoincrement())
    url    String @db.VarChar(500)
    ordem  Int    @default(0)
    tipo   String @db.VarChar(255)

    produtoId BigInt

    produto Produto @relation(fields: [produtoId], references: [id])
}

model Estoque {
    id                   BigInt   @id @default(autoincrement())
    quantidade           Int      @default(0)
    quantidade_reservada Int      @default(0)
    estoque_minimo       Int      @default(0)
    data_atualizacao     DateTime @default(now())

    produtoVariacaoId BigInt

    produtoVariacao ProdutoVariacao @relation(fields: [produtoVariacaoId], references: [id])
}


model Cliente {
    id           BigInt   @id @default(autoincrement())
    nome         String   @db.VarChar(255)
    email        String   @db.VarChar(255)
    telefone     String   @db.VarChar(255)
    cpf          String   @db.VarChar(14)
    dataCadastro DateTime @default(now())

    usuarioId BigInt
    lojaId    BigInt

    usuario Usuario @relation(fields: [usuarioId], references: [id])
    loja    Loja    @relation(fields: [lojaId], references: [id])

    carrinhos Carrinho[]
    pedidos   Pedido[]
}

model Carrinho {
    id               BigInt   @id @default(autoincrement())
    status           String   @db.VarChar(255)
    dataCriacao      DateTime @default(now())
    data_atualizacao DateTime @default(now())

    clienteId BigInt
    lojaId    BigInt

    cliente Cliente @relation(fields: [clienteId], references: [id])
    loja    Loja    @relation(fields: [lojaId], references: [id])

    produtosCarrinho ProdutoCarrinho[]
}


model ProdutoCarrinho {
    id                  BigInt      @id @default(autoincrement())
    quantidade          Int         @default(0)
    preco_unitario      Decimal     @db.Decimal(10, 2)

    carrinhoId          BigInt
    produtoVariacaoId   BigInt

    carrinho            Carrinho        @relation(fields: [carrinhoId], references: [id])
    produtoVariacao     ProdutoVariacao @relation(fields: [produtoVariacaoId], references: [id])
}

model Pedido {
    id          BigInt      @id @default(autoincrement())
    data        DateTime    @default(now())
    status      String      @db.VarChar(255)

    clienteId BigInt
    lojaId    BigInt

    cliente Cliente @relation(fields: [clienteId], references: [id])
    loja    Loja    @relation(fields: [lojaId], references: [id])

    produtosPedidos ProdutoPedido[]
    pagamento       Pagamento[]
}

model ProdutoPedido {
    id                  BigInt      @id @default(autoincrement())
    quantidade          Int         @default(0)
    preco_unitario      Decimal     @db.Decimal(10, 2)
    subtotal            Decimal     @db.Decimal(10, 2)

    pedidoId  BigInt
    produtoId BigInt

    pedido  Pedido  @relation(fields: [pedidoId], references: [id])
    produto Produto @relation(fields: [produtoId], references: [id])
}

model Pagamento {
    id                  BigInt      @id @default(autoincrement())
    valor               Decimal     @db.Decimal(10, 2)
    metodo              String      @db.VarChar(255)
    status              String      @db.VarChar(255)
    codigoTransacao     String      @db.VarChar(255)
    dataPagamento       DateTime    @default(now())

    pedidoId BigInt

    pedido  Pedido  @relation(fields: [pedidoId], references: [id])

}